# functions/.env 로 복사해 값을 채우면 `firebase deploy` 시 함수 환경변수로 반영됩니다.
# (이 폴더의 .env는 gitignore 대상 — 절대 커밋 금지)

# 청약홈 실데이터 — data.go.kr 「한국부동산원_청약홈 APT 분양정보 조회」 serviceKey(디코딩 값)
CHEONGYAK_KEY=

# 네이버 지도 Client ID (NCP 콘솔 → Maps → Application의 ncpKeyId)
NAVER_MAP_KEY=

# 은행 주담대 금리 공시 — 금융감독원 「금융상품 한눈에」 오픈API 인증키 (무료)
# https://finlife.fss.or.kr → 오픈API → 인증키 신청
FSS_KEY=

# 웨딩홀/스드메/정책 리서치용 Gemini API 키 — 무료 티어.
# https://aistudio.google.com/apikey 에서 결제수단 없이 발급. 미설정 시 해당 갱신 버튼만 비활성.
GEMINI_API_KEY=
# GEMINI_MODEL=

# (권장) 리서치 결과 실존 검증용 네이버 검색 API — LLM이 만든 업체명이 실제 등록 업소인지 확인
# https://developers.naver.com/apps → 애플리케이션 등록 → "검색" API 선택 (무료 25,000회/일)
# ⚠️ 지도용 NCP 키와 다른 서비스입니다. 미설정 시 검증 없이 통과.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
