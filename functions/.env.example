# 키 관리 방식이 두 갈래입니다.
#
# ① 서버 전용 비밀키 → Firebase Secret Manager (배포 시 자동 주입)
#      firebase functions:secrets:set CHEONGYAK_KEY
#      firebase functions:secrets:set FSS_KEY
#      firebase functions:secrets:set GEMINI_API_KEY
#      firebase functions:secrets:set NAVER_SEARCH_CLIENT_ID
#      firebase functions:secrets:set NAVER_SEARCH_CLIENT_SECRET
#      firebase functions:secrets:set ANTHROPIC_API_KEY
#    로컬 에뮬레이터에서는 같은 키들을 functions/.secret.local 에 KEY=값 형식으로 두면 됩니다.
#    (.env·.secret.local 모두 gitignore 대상 — 절대 커밋 금지)
#
#    - CHEONGYAK_KEY: data.go.kr 「한국부동산원_청약홈 APT 분양정보 조회」 serviceKey(디코딩 값)
#    - FSS_KEY: 금융감독원 「금융상품 한눈에」 오픈API 인증키 (finlife.fss.or.kr, 무료)
#    - GEMINI_API_KEY: 리서치용 Gemini 키 — https://aistudio.google.com/apikey 무료 발급
#    - NAVER_SEARCH_CLIENT_ID/SECRET: 리서치 실존 검증용 네이버 검색 API
#      (developers.naver.com, 무료 25,000회/일. 지도용 NCP 키와 다른 서비스)
#    - ANTHROPIC_API_KEY: AI 상담사(/api/advisor)용 Claude 키 — console.anthropic.com. 없으면 상담사는 503(키 미설정).
#      Gemini 무료 티어 폴백은 아래 ALLOW_GEMINI_FALLBACK=1 을 켠 경우에만 동작한다.
#
# ② 클라이언트에 노출되는 공개 키 → 이 파일을 functions/.env 로 복사해 값 입력

# 네이버 지도 Client ID (NCP 콘솔 → Maps → Application의 ncpKeyId)
NAVER_MAP_KEY=

# 웹 푸시(공고 알림)용 FCM 웹 푸시 인증서 공개키
# Firebase 콘솔 → 프로젝트 설정 → 클라우드 메시징 → 웹 푸시 인증서 → "키 쌍 생성" 후 붙여넣기
FCM_VAPID_KEY=

# 로그인 필요 경로(/api/advisor·research·push-*·me 와 청약·실거래·LH·지오코딩 프록시)를 호출할 수 있는 계정 (쉼표 구분).
# ⚠️ 필수 — 비워두면 서버가 fail-closed 로 위 경로를 전부 503 으로 거절하고, scripts/predeploy-check.js 가 배포를 막는다.
#    firestore.rules 의 목록과 같이 관리할 것. 화면은 /api/me 로 허용 여부만 받는다(정적 파일에 이메일을 두지 않음).
ALLOWED_EMAILS=

# (선택) 상담사 Gemini 폴백 허용 — 1 이면 ANTHROPIC_API_KEY 가 없을 때 GEMINI_API_KEY(무료 티어)로 상담한다.
# 기본 꺼짐: 무료 티어는 입력이 학습에 쓰일 수 있는데 상담 요청에는 부부 연소득·자산·메모가 그대로 실린다.
# ALLOW_GEMINI_FALLBACK=1

# (선택) GEMINI_MODEL=
# (선택) AI 상담사 Claude 모델 — 비우면 claude-sonnet-5
# ANTHROPIC_MODEL=
