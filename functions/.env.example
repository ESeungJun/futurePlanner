# functions/.env 로 복사해 값을 채우면 `firebase deploy` 시 함수 환경변수로 반영됩니다.
# (이 폴더의 .env는 gitignore 대상 — 절대 커밋 금지)

# 청약홈 실데이터 — data.go.kr 「한국부동산원_청약홈 APT 분양정보 조회」 serviceKey(디코딩 값)
CHEONGYAK_KEY=

# 네이버 지도 Client ID (NCP 콘솔 → Maps → Application의 ncpKeyId)
NAVER_MAP_KEY=

# 은행 주담대 금리 공시 — 금융감독원 「금융상품 한눈에」 오픈API 인증키 (무료)
# https://finlife.fss.or.kr → 오픈API → 인증키 신청
FSS_KEY=

# 웨딩홀/정책 리서치 (Claude 웹검색). 미설정 시 해당 갱신 버튼만 비활성.
ANTHROPIC_API_KEY=
