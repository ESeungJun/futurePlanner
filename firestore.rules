rules_version = '2';

// 이 앱의 모든 재무 데이터 보안은 이 규칙 하나에 걸려 있다.
// 클라이언트의 ALLOWED_EMAILS 검사는 화면 제어(UX)용이라 콘솔에서 SDK를 직접 호출하면 우회된다.
// 배포: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // email_verified 필수 — 이메일/비밀번호 등 미인증 이메일을 발급하는 로그인 방식이 켜지면
    // 화이트리스트 주소를 사칭해 가입하는 우회가 가능해진다 (구글 로그인은 항상 verified)
    function isCouple() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'haul.lee@bunjang.co.kr',
          '6951004@gmail.com',
          'pdyn.oo@gmail.com'
        ];
    }

    // 부부 공유 상태(소득·자산·가계부 등) — 허용된 계정만
    match /households/{doc} {
      allow read, write: if isCouple();

      // 관심 매물 사진 — 사진마다 문서 하나(가계 문서 1MB 한도를 피하려고). 줄인 JPEG data URL만, 90만 자 이하
      match /photos/{photo} {
        allow read, delete: if isCouple();
        allow create, update: if isCouple()
          && request.resource.data.keys().hasOnly(['data', 'listingId', 'at', 'by'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*');
      }

      // 결혼 레퍼런스 사진 — 사진마다 문서 둘({id} 원본 1600px, {id}_t 썸네일). 줄인 이미지 data URL만, 90만 자 이하
      match /refimgs/{img} {
        allow read, delete: if isCouple();
        allow create, update: if isCouple()
          && request.resource.data.keys().hasOnly(['data', 'at', 'by'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*');
      }

      // 결혼 업체 계약서(사진·PDF) — 파일 하나를 88만 자 조각 여러 문서로 나눠 둔다({파일id}_{조각}). 첫 조각만 data URL 머리가 있어 형식은 크기·키로만 본다
      match /contracts/{part} {
        allow read, delete: if isCouple();
        allow create, update: if isCouple()
          && request.resource.data.keys().hasOnly(['data', 'fileId', 'part', 'at', 'by'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 880000
          && request.resource.data.part is int && request.resource.data.part < 12;
      }
    }

    // 서버(Admin SDK) 전용 — Admin SDK는 규칙을 우회하므로 클라이언트 접근만 차단하면 된다.
    //   pushTokens: FCM 기기 토큰 (= 푸시 발송 자격)
    //   research  : Gemini 리서치 캐시
    //   notify    : 알림 발송 상태(seen 목록)
    //   usage     : 상담사 1일 호출 카운터 (catch-all 이 클라이언트 접근을 막는다)
    //   subJobs   : 청약 공고 분석 작업·업로드 PDF 조각(parts) (catch-all 이 막는다 — 앱은 /api/sub-job 으로만 본다)
    //   radarJobs : 정책 레이더 갱신 작업 (catch-all 이 막는다 — 앱은 /api/policy-radar?job= 으로만 본다)
    //   vendorPhotos : 스냅 작가 사진 검색 캐시 (catch-all 이 막는다 — 앱은 /api/vendor-photos 로만 본다)
    //   kisToken  :한국투자증권 오픈API 접근토큰 (catch-all 이 막는다 — 절대 클라이언트에 열지 말 것)
    //   research/saving-rates·policy-radar : 예적금 금리·정책 레이더 캐시 (아래 research 규칙)
    match /pushTokens/{doc} { allow read, write: if false; }
    match /research/{doc}   { allow read, write: if false; }
    match /notify/{doc}     { allow read, write: if false; }

    // 명시하지 않은 경로는 전부 거부
    match /{document=**} { allow read, write: if false; }
  }
}
