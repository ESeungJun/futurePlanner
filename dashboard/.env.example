# 이 파일을 `env.product`(또는 `.env`)로 복사한 뒤 값을 채우세요. (dashboard/ 폴더)
# server.js가 시작할 때 자동으로 읽습니다. 우선순위: 실제 환경변수 > env.product > .env.product > .env
# 배포 서비스(Render 등)에서는 Environment Variables 화면에 같은 키로 등록하면 됩니다.

# 청약홈 실데이터 — data.go.kr에서 「한국부동산원_청약홈 APT 분양정보 조회」
# 활용신청 후 발급받은 serviceKey(디코딩된 값)
CHEONGYAK_KEY=

# 뉴스는 구글뉴스 RSS 사용 — 별도 키 불필요

# 네이버 지도 Client ID (NCP 콘솔 → Maps → Application의 ncpKeyId)
# 화면 ⚙️ 설정에 직접 입력한 키가 있으면 그쪽이 우선됩니다.
NAVER_MAP_KEY=

# 실시간 리서치(인기 식장·스드메·정책 "최신 정보로 갱신" 버튼)용 Gemini API 키
# 무료 티어 — https://aistudio.google.com/apikey 에서 결제수단 없이 발급.
# 미설정 시 해당 버튼만 비활성(기본 데이터로 동작).
GEMINI_API_KEY=
# (선택) Gemini 모델 지정 — 미설정 시 gemini-3-flash-preview → 2.5-flash-lite → 2.0-flash 순 자동 선택
# GEMINI_MODEL=

# (권장) 리서치 결과 실존 검증용 네이버 검색 API — LLM이 만든 업체명이 실제 등록 업소인지 확인
# https://developers.naver.com/apps → 애플리케이션 등록 → "검색" API 선택 (무료 25,000회/일)
# ⚠️ 지도용 NCP 키와 다른 서비스입니다. 미설정 시 검증 없이 통과.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 서버 포트 (기본 5173)
# PORT=5173

# 아파트 실거래가(매매·전월세) — data.go.kr에서 두 API 활용신청 시 CHEONGYAK_KEY를 그대로 재사용.
# 별도 키를 쓰려면 MOLIT_KEY 지정.
# MOLIT_KEY=
